{
  "name": "data-importer-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @rahul_kumar_sharma/data-importer build",
    "test": "pnpm --filter @rahul_kumar_sharma/data-importer test",
    "dev": "pnpm --filter playground dev",
    "typecheck": "pnpm --filter @rahul_kumar_sharma/data-importer typecheck",
    "publish:pkg": "pnpm --filter @rahul_kumar_sharma/data-importer publish --access public --no-git-checks"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
